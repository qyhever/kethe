@baseUrl = http://localhost:6308/api
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjE0LCJ0eXBlIjoiYWNjZXNzIiwianRpIjoiMWE0NzdkYTAtNGUxNC00N2Y0LWI5OTItMzAzMWQxYWIwOTVmIiwiaWF0IjoxNzg4NzQ4ODczLCJleHAiOjE3ODg3NTYwNzMsImlzcyI6ImtldGhlIn0.HR6jjR7OACYyCUIGGTTj831UYatDkfnJS89a5ctbA_k
@categoryId = 1
@accountId = 1
@transactionId = 1
@memberId = 1

### 分类树
GET {{baseUrl}}/categories?categoryType=1
Authorization: Bearer {{token}}

### 账户列表
GET {{baseUrl}}/accounts
Authorization: Bearer {{token}}

### 新增支出（金额单位：分）
POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "transactionType": 1,
  "amount": "3800",
  "categoryId": "{{categoryId}}",
  "accountId": "{{accountId}}",
  "memberId": null,
  "currency": "CNY",
  "transactionTime": "2026-09-06T04:00:00.000Z",
  "timePrecision": 2,
  "remark": "午餐"
}

### 流水分页
POST {{baseUrl}}/transactions/query
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPage": 1,
  "pageSize": 20,
  "startTime": "2026-09-01T00:00:00.000Z",
  "endTime": "2026-10-01T00:00:00.000Z",
  "categoryIds": [],
  "accountIds": [],
  "memberIds": []
}

### 首页概览
GET {{baseUrl}}/dashboard/overview
Authorization: Bearer {{token}}

### 月度趋势
GET {{baseUrl}}/reports/trend?view=month&month=2026-09
Authorization: Bearer {{token}}

### 周趋势（ISO 周，周一至周日）
GET {{baseUrl}}/reports/trend?view=week&week=2026-W38
Authorization: Bearer {{token}}

### 月度账单
GET {{baseUrl}}/bills/monthly?month=2026-09
Authorization: Bearer {{token}}

### CSV 导出（最多 366 天）
GET {{baseUrl}}/exports/transactions.csv?startTime=2026-09-01T00:00:00.000Z&endTime=2026-10-01T00:00:00.000Z
Authorization: Bearer {{token}}

### 成员列表（expenseAmount 为累计支出，单位：分）
GET {{baseUrl}}/members
Authorization: Bearer {{token}}

### 预置成员图标标识
GET {{baseUrl}}/members/options
Authorization: Bearer {{token}}

### 成员详情
GET {{baseUrl}}/members/{{memberId}}
Authorization: Bearer {{token}}

### 新增成员
POST {{baseUrl}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "家人", "iconKey": "family" }

### 编辑成员
PATCH {{baseUrl}}/members/{{memberId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "自己", "iconKey": "heart" }

### 删除成员（软删除，历史关联保留）
DELETE {{baseUrl}}/members/{{memberId}}
Authorization: Bearer {{token}}

### 查询成员全部支出（省略日期可跨年查询）
POST {{baseUrl}}/transactions/query
Authorization: Bearer {{token}}
Content-Type: application/json

{ "transactionType": 1, "memberIds": ["{{memberId}}"] }

### 查询当前个人资料
GET {{baseUrl}}/user/me
Authorization: Bearer {{token}}

### 修改当前昵称或用户名（至少一个字段）
PATCH {{baseUrl}}/user/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nickname": "记账用户",
  "username": "ledger-user"
}

### 更换头像（将 ./avatar.png 替换为本地图片，最大 5 MiB）
POST {{baseUrl}}/user/me/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=ProfileAvatarBoundary

--ProfileAvatarBoundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./avatar.png
--ProfileAvatarBoundary--
